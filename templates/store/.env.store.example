# Local publishing only. Copy to .env.store in the repository root (git-ignored).
# Pipelines set these as secret variables instead.

# ── Chrome Web Store (API v2, service account) ──
# The service account's JSON key file - one of these two:
CHROME_SERVICE_ACCOUNT_KEY_FILE=
# CHROME_SERVICE_ACCOUNT_JSON=

# ── Microsoft Edge Add-ons (API v1.1) ──
# Partner Center → Microsoft Edge → Publish API. The API key expires - note the date.
EDGE_CLIENT_ID=
EDGE_API_KEY=
