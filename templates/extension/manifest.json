{
  "manifest_version": 3,
  "name": "{{displayName}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "{{displayName}}",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  }
}
